.IX Item "armv8.8-a : Armv8.8-a : armv8.7-a, +mops"
.IP "\fBarmv8.9\-a\fR : Armv8.9\-a : \fBarmv8.8\-a\fR" 4
.IX Item "armv8.9-a : Armv8.9-a : armv8.8-a"
