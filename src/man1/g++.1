.IX Item "armv8.6-a : Armv8.6-A : armv8.5-a, +bf16, +i8mm"
.IP "\fBarmv8.7\-a\fR : Armv8.7\-A : \fBarmv8.6\-a\fR, \fB+wfxt\fR, \fB+xs\fR" 4
.IX Item "armv8.7-a : Armv8.7-A : armv8.6-a, +wfxt, +xs"
