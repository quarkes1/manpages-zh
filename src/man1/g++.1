.IX Item "-preload"
.IP \fB\-read_only_relocs\fR 4
.IX Item "-read_only_relocs"
.IP \fB\-sectalign\fR 4
.IX Item "-sectalign"
.IP \fB\-sectcreate\fR 4
.IX Item "-sectcreate"
.IP \fB\-seg_addr_table\fR 4
.IX Item "-seg_addr_table"
.IP \fB\-seg1addr\fR 4
.IX Item "-seg1addr"
.IP \fB\-segaddr\fR 4
.IX Item "-segaddr"
.IP \fB\-segprot\fR 4
.IX Item "-segprot"
